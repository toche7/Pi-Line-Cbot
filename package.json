{
  "name": "pi-sdk-customer-demo",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "start": "node --env-file-if-exists=.env dist/main.js",
    "chat": "node --env-file-if-exists=.env dist/main.js --chat",
    "chat:natural": "node --env-file-if-exists=.env dist/natural-main.js",
    "check:natural": "node --env-file-if-exists=.env dist/natural-main.js --check",
    "server": "node --env-file-if-exists=.env dist/server.js",
    "requests:admin": "node dist/requests-admin-main.js",
    "line:check": "node --env-file-if-exists=.env dist/line-readiness.js",
    "check": "node --env-file-if-exists=.env dist/main.js --check",
    "test": "node --test dist/*.test.js",
    "test:catalog-import": "node --test scripts/catalog-import.test.mjs",
    "ngrok": "node --env-file=.env scripts/ngrok-line.mjs",
    "ngrok:sync": "node --env-file=.env scripts/ngrok-line.mjs --sync",
    "test:ngrok": "node --test scripts/ngrok-line.test.mjs"
  },
  "engines": {
    "node": ">=22.19.0"
  },
  "dependencies": {
    "@earendil-works/pi-ai": "1.4.0",
    "@earendil-works/pi-coding-agent": "1.4.0",
    "@sinclair/typebox": "0.34.52",
    "google-auth-library": "11.3.2"
  },
  "devDependencies": {
    "@types/node": "26.6.5",
    "typescript": "7.0.2"
  }
}
