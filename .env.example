GROQ_API_KEY=
PI_PROVIDER=groq
PI_MODEL=qwen/qwen3.8-27b
PI_TIMEOUT_MS=45000
# LINE test OA: fill locally, never paste credentials into chat.
LINE_CHANNEL_ID=
LINE_CHANNEL_SECRET=
LINE_CHANNEL_ACCESS_TOKEN=
LINE_ALLOWED_USER_IDS=
LINE_DRY_RUN=true
HOST=127.0.0.1
PORT=3000
# Documentation/config placeholder. Does not create a public endpoint.
PUBLIC_BASE_URL=

# Optional staff Google login. Fill locally; never commit actual values.
# All three GOOGLE_* values are required together. Default local mode keeps admin on loopback.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=
ADMIN_BOOTSTRAP_EMAIL=

# Cloud trial only: use Railway Variables with a NEW LINE channel and fresh volume.
# Leave unset for existing local operation. See RAILWAY_RUNBOOK.md.
# DEPLOYMENT_MODE=cloud
# DATA_ROOT=/data
# PUBLIC_BASE_URL=https://<cloud-domain>
# GOOGLE_REDIRECT_URI=https://<cloud-domain>/auth/google/callback

# Optional non-secret display label for the current server (cloud falls back to Railway service name).
# SERVER_NAME=CBot local
